# ==========================================================================
# FaceMatch configuration — copy to `.env` and edit. Every key can also be
# set as a real environment variable (same names, no file needed).
# ==========================================================================

# --- server -----------------------------------------------------------------
FACEMATCH_HOST=0.0.0.0
FACEMATCH_PORT=8000

# --- pipeline ---------------------------------------------------------------
# opencv_sface (default, light) | arcface (higher accuracy, heavier) |
# remote_api (cloud) | deterministic (tests only)
FACEMATCH_EMBEDDER=opencv_sface
# where the ONNX models live (see scripts/download_models.py)
FACEMATCH_MODELS_DIR=models
# detector confidence floor 0..1
FACEMATCH_DETECTION_SCORE_THRESHOLD=0.6
# cosine similarity required to declare "same person".
# 0 = use the backend's recommended default (sface 0.363 / arcface 0.40)
FACEMATCH_MATCH_THRESHOLD=0
FACEMATCH_TOP_K=5
FACEMATCH_MAX_UPLOAD_MB=25
FACEMATCH_MAX_DETECTION_EDGE=1600

# --- vector index -------------------------------------------------------------
# auto | numpy | faiss   (auto upgrades numpy -> faiss past the cutoff)
FACEMATCH_INDEX_BACKEND=auto
FACEMATCH_FAISS_MIN_VECTORS=1000000

# --- storage adapter ------------------------------------------------------------
# folder (default, dev friendly) | sqlite (single file, scales) | http (remote)
FACEMATCH_STORE=folder
FACEMATCH_DATA_DIR=data
FACEMATCH_SQLITE_FILENAME=facematch.db
# only for store=http
FACEMATCH_STORE_URL=
FACEMATCH_STORE_API_KEY=

# --- remote embedder (only when FACEMATCH_EMBEDDER=remote_api) -------------------
FACEMATCH_REMOTE_EMBED_URL=
FACEMATCH_REMOTE_EMBED_API_KEY=
FACEMATCH_REMOTE_EMBED_DIM=512

# --- misc -----------------------------------------------------------------------
FACEMATCH_LOG_LEVEL=INFO
FACEMATCH_CORS_ORIGINS=*
